{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
        "run": {
            "type": "object",
            "properties": {
                "dir": {
                    "type": "string",
                    "description": "Directory where the workflow will be executed (Optional)."
                }
            },
            "additionalProperties": false
        },
        "workflow": {
            "type": "object",
            "properties": {
                "mapper": {
                    "type": "string",
                    "enum": [
                        "minimap2"
                    ]
                },
                "callers": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "enum": [
                            "clair3",
                            "cutesv",
                            "debreak",
                            "delly",
                            "nanosv",
                            "nanovar",
                            "severus",
                            "sniffles",
                            "svim",
                            "svision"
                        ]
                    },
                    "minItems": 1,
                    "uniqueItems": true
                },
                "annotators": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "enum": [
                            "snpeff",
                            "vep",
                            "annotsv"
                        ]
                    },
                    "minItems": 1,
                    "uniqueItems": true
                }
            },
            "required": [
                "mapper",
                "callers",
                "annotators"
            ],
            "additionalProperties": false
        },
        "inputs": {
            "type": "object",
            "properties": {
                "fasta": {
                    "type": "string"
                },
                "index_minimap2": {
                    "type": "string"
                },
                "dir_data": {
                    "type": "string"
                },
                "suffix_fastq": {
                    "type": "string"
                }
            },
            "required": [
                "fasta",
                "index_minimap2",
                "dir_data",
                "suffix_fastq"
            ],
            "additionalProperties": false
        },
        "filtering": {
            "type": "object",
            "properties": {
                "min_reads": {
                    "type": "integer",
                    "minimum": 1
                },
                "min_length_reads": {
                    "type": "integer",
                    "minimum": 1
                },
                "min_quality_mapping": {
                    "type": "integer",
                    "minimum": 1
                },
                "min_coverage": {
                    "type": "integer",
                    "minimum": 1
                },
                "min_size": {
                    "type": "integer",
                    "minimum": 1
                },
                "max_size": {
                    "type": "integer",
                    "minimum": 0
                },
                "min_dhffc": {
                    "type": "number",
                    "minimum": 0
                },
                "max_dhbfc": {
                    "type": "number",
                    "minimum": 0
                },
                "distance_sv": {
                    "$ref": "#/$defs/svIntegerSettings"
                },
                "n_callers": {
                    "$ref": "#/$defs/svIntegerSettings"
                },
                "consider_type": {
                    "$ref": "#/$defs/svBooleanSettings"
                },
                "consider_strand": {
                    "$ref": "#/$defs/svBooleanSettings"
                },
                "estimate_distance": {
                    "$ref": "#/$defs/svBooleanSettings"
                }
            },
            "required": [
                "min_reads",
                "min_length_reads",
                "min_quality_mapping",
                "min_coverage",
                "min_size",
                "max_size",
                "min_dhffc",
                "max_dhbfc",
                "distance_sv",
                "n_callers",
                "consider_type",
                "consider_strand",
                "estimate_distance"
            ],
            "additionalProperties": false
        },
        "annotation": {
            "type": "object",
            "properties": {
                "terms_relative": {
                    "type": "string"
                },
                "species": {
                    "type": "string"
                },
                "genome": {
                    "type": "string"
                },
                "snpeff": {
                    "$ref": "#/$defs/snpeff"
                },
                "vep": {
                    "$ref": "#/$defs/vep"
                },
                "annotsv": {
                    "$ref": "#/$defs/annotsv"
                }
            },
            "required": [
                "terms_relative",
                "species",
                "genome",
                "snpeff",
                "vep",
                "annotsv"
            ],
            "additionalProperties": false
        },
        "caller_settings": {
            "type": "object",
            "properties": {
                "tandem_repeats": {
                    "type": "string"
                },
                "nvtr": {
                    "type": "string"
                },
                "nanosv": {
                    "type": "object",
                    "properties": {
                        "config": {
                            "type": "string"
                        },
                        "bed": {
                            "type": "string",
                            "description": "NanoSV bed filtering. (Optional, only hg19 is available on github)"
                        }
                    },
                    "required": [
                        "config"
                    ],
                    "additionalProperties": false
                },
                "clair3": {
                    "type": "object",
                    "properties": {
                        "model": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "model"
                    ],
                    "additionalProperties": false
                },
                "svision": {
                    "type": "object",
                    "properties": {
                        "model": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "model"
                    ],
                    "additionalProperties": false
                }
            },
            "required": [
                "tandem_repeats",
                "nvtr",
                "nanosv",
                "clair3",
                "svision"
            ],
            "additionalProperties": false
        },
        "resources": {
            "type": "object",
            "properties": {
                "downloads": {
                    "$ref": "#/$defs/resourceDownloads"
                }
            },
            "required": [
                "downloads"
            ],
            "additionalProperties": false
        }
    },
    "required": [
        "run",
        "workflow",
        "inputs",
        "filtering",
        "annotation",
        "caller_settings",
        "resources"
    ],
    "additionalProperties": false,
    "$defs": {
        "svIntegerSettings": {
            "type": "object",
            "properties": {
                "BND": {
                    "type": "integer",
                    "minimum": 1
                },
                "DEL": {
                    "type": "integer",
                    "minimum": 1
                },
                "INS": {
                    "type": "integer",
                    "minimum": 1
                },
                "INV": {
                    "type": "integer",
                    "minimum": 1
                },
                "DUP": {
                    "type": "integer",
                    "minimum": 1
                }
            },
            "required": [
                "BND",
                "DEL",
                "INS",
                "INV",
                "DUP"
            ],
            "additionalProperties": false
        },
        "svBooleanSettings": {
            "type": "object",
            "properties": {
                "BND": {
                    "type": "boolean"
                },
                "DEL": {
                    "type": "boolean"
                },
                "INS": {
                    "type": "boolean"
                },
                "INV": {
                    "type": "boolean"
                },
                "DUP": {
                    "type": "boolean"
                }
            },
            "required": [
                "BND",
                "DEL",
                "INS",
                "INV",
                "DUP"
            ],
            "additionalProperties": false
        },
        "snpeff": {
            "type": "object",
            "properties": {
                "version": {
                    "type": "string"
                },
                "cache": {
                    "type": "string"
                }
            },
            "required": [
                "version",
                "cache"
            ],
            "additionalProperties": false
        },
        "vep": {
            "type": "object",
            "properties": {
                "version": {
                    "type": "integer"
                },
                "cache": {
                    "type": "string"
                },
                "max_size": {
                    "type": "integer",
                    "minimum": 0
                }
            },
            "required": [
                "version",
                "cache",
                "max_size"
            ],
            "additionalProperties": false
        },
        "annotsv": {
            "type": "object",
            "properties": {
                "version": {
                    "type": "string"
                },
                "cache": {
                    "type": "string"
                }
            },
            "required": [
                "version",
                "cache"
            ],
            "additionalProperties": false
        },
        "resourceDownload": {
            "type": "object",
            "properties": {
                "url": {
                    "type": "string",
                    "format": "uri"
                },
                "checksum": {
                    "type": "string",
                    "pattern": "^(md5|sha256):[0-9a-fA-F]+$"
                },
                "compression": {
                    "type": "string",
                    "enum": [
                        "none",
                        "gzip"
                    ]
                },
                "postprocess": {
                    "type": "string",
                    "enum": [
                        "none",
                        "ucsc_canonical"
                    ]
                },
                "archive_root": {
                    "type": "string"
                },
                "version": {
                    "type": "string"
                }
            },
            "additionalProperties": false
        },
        "resourceDownloadByAssembly": {
            "type": "object",
            "properties": {
                "assemblies": {
                    "type": "object",
                    "additionalProperties": {
                        "$ref": "#/$defs/resourceDownload"
                    }
                }
            },
            "required": [
                "assemblies"
            ],
            "additionalProperties": false
        },
        "resourceDownloads": {
            "type": "object",
            "properties": {
                "reference": {
                    "$ref": "#/$defs/resourceDownloadByAssembly"
                },
                "tandem_repeats": {
                    "$ref": "#/$defs/resourceDownloadByAssembly"
                },
                "nvtr": {
                    "$ref": "#/$defs/resourceDownloadByAssembly"
                },
                "clair3_model": {
                    "$ref": "#/$defs/resourceDownload"
                },
                "svision_model": {
                    "$ref": "#/$defs/resourceDownload"
                },
                "nanosv_config": {
                    "$ref": "#/$defs/resourceDownload"
                },
                "nanosv_bed": {
                    "$ref": "#/$defs/resourceDownloadByAssembly"
                },
                "annotsv_human": {
                    "$ref": "#/$defs/resourceDownload"
                },
                "annotsv_exomiser": {
                    "$ref": "#/$defs/resourceDownload"
                }
            },
            "additionalProperties": false
        }
    }
}